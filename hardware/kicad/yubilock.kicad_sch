  ; ============================================
  ; TEXT ANNOTATIONS
  ; ============================================

  (text "ESP32 GPIO Connections:\n- GPIO18: SPI SCK (PN532)\n- GPIO19: SPI MISO (PN532)\n- GPIO23: SPI MOSI (PN532)\n- GPIO5: SPI SS (PN532)\n- GPIO4: IRQ (PN532)\n- GPIO26: Relay Control\n- GPIO27: Green LED\n- GPIO14: Red LED\n- GPIO32: Buzzer\n- GPIO33: Tamper Switch"
    (at 20.32 -120.65 0)
    (effects (font (size 2.54 2.54)) (justify left))
  )

  (text "POWER SECTION"
    (at 20.32 -30.48 0)
    (effects (font (size 3.81 3.81) bold) (justify left))
  )

  (text "NFC READER (PN532) - SPI MODE"
    (at 120.65 -30.48 0)
    (effects (font (size 3.81 3.81) bold) (justify left))
  )

  (text "RELAY & LOCK CONTROL"
    (at 220.98 -30.48 0)
    (effects (font (size 3.81 3.81) bold) (justify left))
  )

  (text "LED INDICATORS"
    (at 20.32 -160.02 0)
    (effects (font (size 3.81 3.81) bold) (justify left))
  )

  (text "BUZZER DRIVER"
    (at 120.65 -160.02 0)
    (effects (font (size 3.81 3.81) bold) (justify left))
  )

  (text "TAMPER DETECTION"
    (at 220.98 -160.02 0)
    (effects (font (size 3.81 3.81) bold) (justify left))
  )

  (text "Notes:\n1. PN532 must be set to SPI mode (DIP: SW1=OFF, SW2=ON)\n2. 2N2222A transistors in TO-92 package (E-B-C pinout)\n3. 1N4007 flyback diode protects against relay coil back-EMF\n4. All LEDs are 5mm standard, forward voltage ~2V\n5. Buzzer is active type, 5V\n6. Tamper switch is Normally Closed (NC)"
    (at 20.32 -240 0)
    (effects (font (size 2.54 2.54)) (justify left))
  )

